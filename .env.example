# Required: AI_MODEL must support vision (image input) for script generation from screen-recording frames.
AI_BASE_URL=<your_llm_base_url_here>
AI_MODEL=<your_llm_model_name_here>
AI_API_KEY=<your_llm_api_key_here>

# Optional: point to a custom ffmpeg binary.
FFMPEG_PATH=ffmpeg

# Optional: host port for the web UI (default 3000). Do not set to 8080 (backend internal port).
# FRONTEND_PORT=3000
