# Generated at container start from VDS_DOMAIN (see docker-entrypoint.sh).
# @SITE@ is :80 for local HTTP, or your public hostname for automatic HTTPS.

@SITE@ {
	root * /srv
	encode gzip zstd

	request_body {
		max_size 500MB
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle /ws/* {
		reverse_proxy backend:8080 {
			transport http {
				read_timeout 3600s
			}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
